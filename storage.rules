rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Rent registration PDFs — uploaded from the Certificates section.
    // Any authenticated user can read/write; front-end gates by section.
    match /rentRegistrations/{filename} {
      allow read, write: if request.auth != null;
    }

    // Turnover project photos (before / after) — uploaded from each
    // turnover card. Any authenticated user can read/write.
    match /turnovers/{projectId}/{phase}/{filename} {
      allow read, write: if request.auth != null;
    }

    // Construction project photos (before / after) — uploaded from each
    // construction project card. Any authenticated user can read/write.
    match /constructionProjects/{projectId}/{phase}/{filename} {
      allow read, write: if request.auth != null;
    }

    // Documents Tracking attachments (PDF or image) — uploaded from
    // the Documents Tracking section. Any authenticated user can
    // read/write; the section's front-end gates delete to admins.
    match /documents/{docId}/{filename} {
      allow read, write: if request.auth != null;
    }

    // Collection notices (30-day / 3-day notice photos) — uploaded
    // from the Collection Houses tab per property.
    match /collectionNotices/{propertyId}/{kind}/{filename} {
      allow read, write: if request.auth != null;
    }

    // Default deny everything else.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
